# generated from cargo_build_caller.nix.handlebars using cargo (manual edits won't be persistent)
# project_root: the directory the workspace's path crates are built from; pass your own to build another
# checkout, e.g. `import "${generated}/cargo_build_caller.nix" { project_root = ./.; }` (IFD)
{ system ? builtins.currentSystem, project_root ? {{{project_root}}}/. }:
let
  nixpkgsSrc = builtins.fetchTarball {
    url = "https://github.com/NixOS/nixpkgs/archive/26.05.tar.gz";
    sha256 = "sha256:0am8xx09fx5yf2p0wb001v0jx1g5hrfb76h4r37xph378jgk7pcr";
  };
  pkgs = import (nixpkgsSrc + "/pkgs/top-level/default.nix") {
    localSystem = { inherit system; };
  };

  fenixSrc = pkgs.fetchFromGitHub {
    owner = "nix-community";
    repo = "fenix";
    rev = "6ed03ef4c8ec36d193c18e06b9ecddde78fb7e42";
    sha256 = "sha256-tl/0cnsqB/Yt7DbaGMel2RLa7QG5elA8lkaOXli6VdY=";
  };
  # fenix defaults to builtins.currentSystem, which pure (flake) evaluation lacks
  fenix = import fenixSrc { inherit system; };

  # import of fenix's default.nix (not its flake): the package set itself, no packages.${system}
  manifest_1_87 = {
    channel = "1.87.0";
    sha256 = "sha256-KUm16pHj+cRedf8vxs/Hd2YWxpOrWZ7UOrwhILdSJBU=";
  };
  toolchain_1_87_vanilla_pin = fenix.toolchainOf manifest_1_87;

  # the --target triples of the build (cross compiling), other than the host: their std from the same manifest
  targets = builtins.filter (t: t != pkgs.stdenv.hostPlatform.rust.rustcTarget) [ {{#each targets}}"{{{this}}}" {{/each}}];
  rust_std_1_87_targets = map (t: (fenix.targets.${t}.toolchainOf manifest_1_87).rust-std) targets;

  # rustc with std only: a toolchain with rust-src makes rustc map std's /rustc/<commit>/ panic locations to
  # the toolchain's store path, which then lands in every binary's runtime closure (nixcloud/pankat-rs#24). With
  # --target, fenix's combine (it copies rustc, so its sysroot is the combination) adds the std of the targets.
  # 1.87 links with the cc's ld (rustc's own lld is the default since 1.90), so its bundled ld.lld needs no wrapper
  rustc_1_87_vanilla_pin =
    if targets == [ ] then toolchain_1_87_vanilla_pin.rustc
    else fenix.combine ([ toolchain_1_87_vanilla_pin.rustc ] ++ rust_std_1_87_targets);
  cargo_1_87_vanilla_pin = toolchain_1_87_vanilla_pin.cargo;
  # the rustc the units build with, also for the gc roots and the rustdoc of the doc tests
  toolchain = rustc_1_87_vanilla_pin;

  external_crate_dependencies = { deps = {}; envs = {}; } //
    (if builtins.pathExists (project_root + "/Cargo.dependencies.nix")
    then builtins.trace "Using Cargo.dependencies.nix"
         import (project_root + "/Cargo.dependencies.nix") { inherit pkgs; }
    else builtins.trace "No Cargo.dependencies.nix found" {});

  cargoPackages = import ./derivations/default.nix {
    inherit pkgs external_crate_dependencies project_root;
    rustc = rustc_1_87_vanilla_pin;
    cargo = cargo_1_87_vanilla_pin;
  };

  # everything a build uses that is worth keeping: the units, their sources (crate tarballs), the toolchain (with
  # the C compiler that links), build-rs-libnix and the external dependencies from Cargo.dependencies.nix. cargo
  # roots it in target/<profile>/nix/gc, so nix-collect-garbage doesn't remove the dependency builds, and deletes
  # what the previous build listed but this one doesn't (nixcloud/cargo#4)
  lib = pkgs.lib;
  derivationsIn = x:
    if lib.isDerivation x then [ x ]
    else if builtins.isList x then lib.concatMap derivationsIn x
    else if builtins.isAttrs x then lib.concatMap derivationsIn (builtins.attrValues x)
    else [ ];
  units = derivationsIn (removeAttrs cargoPackages [ "fn" ]);
  roots = units
    ++ lib.filter (s: s != null) (map (u: u.src or null) units)
    # they reference the unit outputs, so the old ones would keep old units alive
    ++ map (u: cargoPackages.fn.rustc_linker_arguments_dir u.rust_crate_libraries)
      (lib.filter (u: u ? rust_crate_libraries) units)
    # what the build script runs parse their output with; only when there are any, it is a build of its own
    ++ lib.optional (lib.any (u: (u.meta.cargo_crate_info.type or "") == "(build.rs run)") units)
      cargoPackages.fn.build_rs_libnix_package
    # only the `out` of the C compiler, not its man and info pages
    ++ [ toolchain "${pkgs.stdenv.cc}" ]
    ++ derivationsIn external_crate_dependencies.deps;
  retainedPaths = lib.unique (lib.concatMap
    (r: if lib.isDerivation r then map (o: toString r.${o}) (r.outputs or [ "out" ]) else [ (toString r) ])
    roots);
  # what cargo runs outside of nix on the unit outputs (doc tests), the same rustdoc and linker as the units use
  tools = [ "# rustdoc ${toolchain}/bin/rustdoc" "# linker ${pkgs.stdenv.cc}/bin/cc" ];
  retainedName = "cargo-libnix-retained-paths-units-crates-toolchain-deps";
in
  cargoPackages // {
    ${retainedName} = pkgs.writeText retainedName (lib.concatLines (retainedPaths ++ tools));
  }
