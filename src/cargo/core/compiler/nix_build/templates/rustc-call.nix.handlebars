# generated from rustc-call.nix.handlebars
{ {{{function_arguments}}} }:
  pkgs.stdenv.mkDerivation rec {
    name = "{{{fullname}}}";
{{{cargo_crate_info}}}
    buildInputs = [{{{build_inputs}}}] ++ fn.inject meta.cargo_crate_info;
    passthru.rust_crate_libraries = [{{{rust_crate_libraries}}}];
    passthru.rust_crate_parent = [{{{rust_crate_parent}}}];
    passthru.rust_script_build_run = [{{{rust_script_build_run}}}];
    phases = "unpackPhase buildPhase";

{{{src}}}
{{{unpack_phase}}}

    RUSTC = "${rustc}/bin/rustc";
    CARGO = "${cargo}/bin/cargo";

{{{environment_variables}}}

    buildPhase = ''
      export CARGO_MANIFEST_DIR=$(realpath $PWD/$CARGO_MANIFEST_DIR)
      export CARGO_MANIFEST_PATH=$(realpath $PWD/$CARGO_MANIFEST_PATH)

      mkdir -p $out/nix
      export OUT_DIR=$out
      export INC_DIR=$(mktemp -d)

      echo -e "\e[92mCompiling\e[0m {{{fullname}}}"
{{{additional_build_phase_arguments}}}
      (set -x 
{{{command_line}}}
      )
    '';
}