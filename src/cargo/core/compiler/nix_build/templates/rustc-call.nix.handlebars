# generated from rustc-call.nix.handlebars
{ {{{function_arguments}}} }:

let
  allCollectedInputs = a: builtins.foldl' (acc: el: acc ++ [el] ++ (allCollectedInputs el.requiredInputs)) [] a;
in

  pkgs.stdenv.mkDerivation rec {
    name = "{{{fullname}}}";
    buildInputs = [{{{build_inputs}}}];
    passthru.requiredInputs = [{{{required_inputs}}}];
    phases = "unpackPhase buildPhase installPhase";
    _L_arguments = builtins.concatStringsSep " " (map (lib: "-L ${lib}") (allCollectedInputs buildInputs));

{{{src}}}
{{{unpack_phase}}}
    RUSTC = "${rustc}/bin/rustc";
    CARGO = "${cargo}/bin/cargo";
{{{environment_variables}}}

    buildPhase = ''
      export OUT_DIR=$(mktemp -d)
      export INC_DIR=$(mktemp -d)
{{{additional_build_phase_arguments}}}
      set -x
{{{command_line}}}
      set +x
    '';

    installPhase = ''
{{{install_phase}}}
    '';
}