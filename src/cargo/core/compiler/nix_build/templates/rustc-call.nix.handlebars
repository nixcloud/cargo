# generated from rustc-call.nix.handlebars using cargo (manual edits won't be persistent)
{ {{{function_arguments}}} }: with deps;
  pkgs.stdenv.mkDerivation rec {
    name = "{{{fullname}}}";
{{{cargo_crate_info}}}
    buildInputs = [] ++ fn.inject_deps meta.cargo_crate_info;
    env = fn.inject_envs meta.cargo_crate_info;

    passthru.rust_crate_libraries = [{{{rust_crate_libraries}}}];
    passthru.rust_crate_parent = [{{{rust_crate_parent}}}];
    passthru.rust_script_build_run = [{{{rust_script_build_run}}}];
    phases = "{{{nix_phases}}}";

{{{src}}}
{{{unpack_phase}}}

    RUSTC = "${rustc}/bin/rustc";

{{{environment_variables}}}

    buildPhase = ''
      export CARGO_MANIFEST_DIR=$(realpath $PWD/$CARGO_MANIFEST_DIR)
      export CARGO_MANIFEST_PATH=$(realpath $PWD/$CARGO_MANIFEST_PATH)
      {{{change_directory}}}

      mkdir -p $out/nix
      export OUT_DIR=$out
      export INC_DIR=$(${pkgs.mktemp}/bin/mktemp -d)

      echo -e "\e[92mCompiling\e[0m {{{fullname}}}"
      echo "@cargo { \"type\":0, \"crate_name\":\"{{{crate_name}}}\", \"id\":\"{{{fullname}}}\" }"
{{{additional_build_phase_arguments}}}
{{{command_line}}}
    '';
{{{append}}}
}